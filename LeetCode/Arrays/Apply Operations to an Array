class Solution {
public:
    vector<int> applyOperations(vector<int>& nums) {
        vector<int> newarr;
        int n=nums.size();
        int count=0;

        for(int i=0;i<n;i++){
            if(i<n-1 && nums[i]!=0){
                if(nums[i]==nums[i+1]){
                    nums[i]*=2;
                    nums[i+1]=0;
                }
            }
        }

            for(int x:nums){
                if(x!=0){
                    newarr.push_back(x);
                }
                else{
                count++;
                }
            }

        while(count>0){
            newarr.push_back(0);
            count--;
        }

        return newarr;
    }
};
