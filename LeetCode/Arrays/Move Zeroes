class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        vector<int> newarr;
        int n=nums.size();
        int count=0;

        for(int i=0;i<n;i++){
            if(nums[i]!=0){
                newarr.push_back(nums[i]);
            }
            else{
                count++;
            }
        }
        while(count>0){
        newarr.push_back(0);
        count--;
        }
       nums=newarr;
    }
};
